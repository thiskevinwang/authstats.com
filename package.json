{
	"name": "authstats.com",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"test": "vitest run",
		"worker:dev": "opennextjs-cloudflare build && wrangler dev --port 8788 --test-scheduled",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:create": "wrangler d1 create authstats-prod",
		"db:migrate:local": "wrangler d1 migrations apply authstats-prod --local",
		"db:migrate:prod": "wrangler d1 migrations apply authstats-prod --remote",
		"db:migrate:remote": "wrangler d1 migrations apply authstats-prod --remote",
		"etl:trigger:local": "wrangler workflows trigger authstats-download-etl '{\"trigger\":\"manual\"}' --local --port 8788",
		"etl:trigger:prod": "wrangler workflows trigger authstats-download-etl '{\"trigger\":\"manual\"}'",
		"etl:trigger:cron:local": "curl 'http://127.0.0.1:8788/__scheduled?cron=0%20*/6%20*%20*%20*'"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.19.9",
		"better-result": "^2.9.2",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.16.0",
		"next": "16.2.6",
		"react": "^19.1.7",
		"react-dom": "^19.1.7",
		"recharts": "^3.8.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.6",
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.41",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"oxfmt": "^0.50.0",
		"oxlint": "^1.65.0",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"vitest": "^4.1.0",
		"wrangler": "^4.94.0"
	},
	"packageManager": "bun@1.3.6"
}
